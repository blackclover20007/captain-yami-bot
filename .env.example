# The bot no longer accepts pairing from the console. Generate a session on
# session-site/server.js, then put the exported value in SESSION_ID.
SESSION_ID=
# Session website settings (Replit uses node session-site/server.js).
PAIRING_SITE_KEY=
SESSION_AUTH_DIR=./auth_info
PORT=3000
# Delay before the website requests the WhatsApp-generated code.
PAIRING_REQUEST_DELAY_MS=2500
COMMAND_PREFIX=!
BOT_NAME=Captain Yami Bot
BOT_VERSION=Yami Black Clover
BOT_IMAGE_URL=https://www.image2url.com/r2/default/images/1790872649903-cd52d983-a7d2-48ef-9892-655395768334.jpg
CONTACT_NUMBERS=+263714373922 / +263784970429
OWNER_TELEGRAM=@saintbypass
# Your WhatsApp JID, e.g. 15551234567@s.whatsapp.net
OWNER_JID=
# Comma-separated JIDs allowed to use sudoer-level commands.
SUDO_JIDS=
# Comma-separated JIDs allowed to use moderator-level commands.
MODERATOR_JIDS=
# Optional private WhatsApp group JID, e.g. 120363000000000000@g.us
OWNER_LOG_GROUP_JID=
# Optional HTTPS webhook receiving JSON rate-limit alerts.
ALERT_WEBHOOK_URL=
# Optional audio files sent after successful or failed commands.
COMMAND_SUCCESS_SOUND=./media/success.ogg
COMMAND_FAILURE_SOUND=./media/failure.ogg
# TikTok/Instagram temporary media cache settings.
MEDIA_CACHE_TTL_MS=900000
MEDIA_CACHE_MAX_BYTES=536870912
# Minimum time between downloads from the same WhatsApp user, in milliseconds.
DOWNLOAD_COOLDOWN_MS=60000
# Minimum time between role mutations from the same admin.
ROLE_COMMAND_COOLDOWN_MS=5000
# Maximum role mutations allowed per admin within a rolling minute.
ROLE_COMMAND_MAX_PER_MINUTE=5
# Maximum automatic WhatsApp reconnect attempts; 0 means unlimited transient retries.
MAX_RECONNECT_ATTEMPTS=0
